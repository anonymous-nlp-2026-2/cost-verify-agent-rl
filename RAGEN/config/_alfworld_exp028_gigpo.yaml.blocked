# exp028: GiGPO (Group-in-Group Policy Optimization)
# Based on exp027 (stable GRPO), replacing advantage computation with GiGPO.
# GiGPO adds anchor-state-based step-level credit assignment on top of episode-level GRPO.
# Paper: https://arxiv.org/abs/2505.10978
# Expected improvement: +13pp success rate (GRPO 72.8% → GiGPO 86.1% on ALFWorld)

defaults:
  - base

hydra:
  searchpath:
    - pkg://verl.trainer.config

model_path: /root/autodl-tmp/checkpoints/qwen3_exp021_ragen_sft_v4

system:
  CUDA_VISIBLE_DEVICES: "0,1"

micro_batch_size_per_gpu: 1
ppo_mini_batch_size: 32

trainer:
  project_name: cost-verify-agent-rl
  experiment_name: exp028-alfworld-gigpo
  total_training_steps: 50
  n_gpus_per_node: 2
  val_before_train: True
  test_freq: 5
  save_freq: 5
  local_log_dir: "/root/autodl-tmp/checkpoints/exp028/"
  default_local_dir: "/root/autodl-tmp/checkpoints/exp028/"
  logger: ['console', 'wandb']
  max_actor_ckpt_to_keep: 10
  resume_mode: "disable"

actor_rollout_ref:
  model:
    override_config:
      attn_implementation: sdpa
  actor:
    use_ref: True
    use_torch_compile: False
    use_kl_loss: True
    kl_loss_coef: 0.005
    kl_loss_type: low_var_kl
    entropy_coeff: 0.01
    clip_ratio_low: 0.2
    clip_ratio_high: 0.28
    loss_agg_mode: "seq-mean-token-mean"
    grad_clip: 1.0
    optim:
      lr: 5e-7
  ref:
    use_torch_compile: False
  rollout:
    response_length: 1024
    gpu_memory_utilization: 0.4
    max_model_len: 8192
    temperature: 1.0
    max_num_batched_tokens: 8192
    enforce_eager: True
    val_kwargs:
      do_sample: True
      temperature: 0.4

algorithm:
  adv_estimator: grpo
  advantage_type: "gigpo"
  gamma: 0.95
  high_level_gamma: 0.95
  norm_adv_by_std_in_grpo: True
  gigpo:
    step_advantage_w: 1.0
    enable_similarity: false
    similarity_thresh: 0.95

agent_proxy:
  context_window_mode: "step_independent"
  max_context_window: 5
  step_independent_history_length: 5
  max_turn: 50
  max_actions_per_turn: 1
  max_prompt_length: 4096
  use_turn_scores: True

collapse_detection:
  multi_turn_enabled: false

es_manager:
  format_penalty: 0
  train:
    env_groups: 8
    group_size: 16
    env_configs:
      tags: ["AlfworldSG"]
      n_groups: [8]
  val:
    env_groups: 16
    group_size: 1
    env_configs:
      tags: ["AlfworldSG"]
      n_groups: [16]
